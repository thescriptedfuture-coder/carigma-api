# Carigma API — copy to .env and fill in. NEVER commit the real .env.

ENVIRONMENT=development
DEBUG=true

# ── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Auth verification is ASYMMETRIC ONLY. Supabase signs with an ECC P-256 key;
# we fetch the PUBLIC key from JWKS, derived from SUPABASE_URL above.
#
# There is deliberately NO shared-secret setting. An HS256 secret both verifies
# AND MINTS tokens — holding one would let this service forge a session for any
# user. Do not add one back.
# SUPABASE_JWKS_URL=          # only to override the derived URL
SUPABASE_JWT_AUDIENCE=authenticated
JWKS_CACHE_TTL_SECONDS=600

# Server-only. Never ship this to a browser.
SUPABASE_SERVICE_KEY=

# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Admin gate ─────────────────────────────────────────────────────────────
# Comma-separated. Empty means nobody is admin (safe default).
ADMIN_EMAILS=

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Rate limits ────────────────────────────────────────────────────────────
AGENT_RUN_LIMIT_PER_HOUR=20
PUBLIC_LIMIT_PER_MINUTE=5
