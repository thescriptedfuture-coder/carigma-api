# Carigma API — copy to .env and fill in. NEVER commit the real .env.

ENVIRONMENT=development
DEBUG=true

# ── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co

# Auth verification — set ONE of these:
#   Legacy projects (HS256): the shared JWT secret from Supabase settings.
#   Current projects: leave the secret blank; JWKS is derived from SUPABASE_URL.
SUPABASE_JWT_SECRET=
# SUPABASE_JWKS_URL=            # only to override the derived URL
SUPABASE_JWT_AUDIENCE=authenticated

# Server-only. Never ship this to a browser.
SUPABASE_SERVICE_KEY=

# ── Admin gate ─────────────────────────────────────────────────────────────
# Comma-separated. Empty means nobody is admin (safe default).
ADMIN_EMAILS=

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
