# ═══════════════════════════════════════════════════════════════════════════
# CARIGMA API (carigma-api) — environment template
#
# Copy to `.env` in this same folder and fill in.  `.env` is gitignored.
#
#     cp .env.example .env
#
# THIS FILE IS THE SERVER SIDE. Every secret Carigma has lives here and NOWHERE
# else. Nothing in this file is ever sent to a browser.
#
# The rule that keeps the two repos straight:
#   carigma-api/.env        → secrets. Server-only. Never leaves the server.
#   carigma-web/.env.local  → PUBLIC values only. Compiled into the JS bundle
#                             and readable by any user who opens devtools.
# If you are ever unsure which file a value belongs in, ask: "would I be OK
# with a stranger reading this?" If no, it goes here.
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
# ENVIRONMENT
# ───────────────────────────────────────────────────────────────────────────

# development | production
# In production the API refuses to start without a JWKS endpoint (rather than
# running as an open door), and /docs + /openapi.json are disabled.
ENVIRONMENT=development

# Extra logging. Leave false in production.
DEBUG=true


# ───────────────────────────────────────────────────────────────────────────
# SUPABASE
# ───────────────────────────────────────────────────────────────────────────

# Your project URL.
# WHERE: Supabase dashboard → Project Settings → Data API → Project URL
# The JWKS endpoint is DERIVED from this, so setting it correctly is what makes
# auth work at all.
SUPABASE_URL=https://your-project.supabase.co

# The anon (publishable) key. Safe by design — it is constrained by RLS.
# WHERE: Supabase dashboard → Project Settings → API Keys → anon / public
# The API uses it to build a client that then carries the CALLER'S OWN JWT, so
# RLS sees a real auth.uid(). Same key as the web repo uses; not a secret.
SUPABASE_ANON_KEY=

# ── Auth verification ──
# Carigma verifies tokens ASYMMETRICALLY ONLY (ES256 via JWKS). Supabase signs
# with an ECC P-256 key; we fetch the PUBLIC half and verify with it.
#
# ⚠️  THERE IS DELIBERATELY NO `SUPABASE_JWT_SECRET` SETTING, AND YOU SHOULD NOT
#     ADD ONE. An HS256 shared secret both VERIFIES and MINTS tokens — holding
#     one would mean this service could forge a valid session for any user. A
#     verifier should only be able to verify. A test asserts the field stays
#     gone.

# Optional. Only set this to OVERRIDE the URL derived from SUPABASE_URL.
# Leave blank in normal use.
# SUPABASE_JWKS_URL=

# The `aud` claim Supabase puts in a signed-in user's token. Almost never
# changes. WHERE: visible in any decoded token (jwt.io) if you need to confirm.
SUPABASE_JWT_AUDIENCE=authenticated

# How long the fetched public keys are cached, in seconds. On a cache miss the
# API refetches once automatically, so a rotated key does NOT need a redeploy
# and does NOT cause a wave of 401s. 600 = 10 minutes.
JWKS_CACHE_TTL_SECONDS=600

# ── Service role — THE MOST DANGEROUS VALUE IN THE PROJECT ──
# Bypasses ALL row-level security. Used only by admin endpoints and cron.
# WHERE: Supabase dashboard → Project Settings → API Keys → service_role
# NEVER put this in carigma-web, in a VITE_ variable, or in any client code.
# If it ever leaks, rotate it in Supabase immediately.
SUPABASE_SERVICE_KEY=


# ───────────────────────────────────────────────────────────────────────────
# ANTHROPIC — the agent intelligence
# ───────────────────────────────────────────────────────────────────────────

# WHERE: https://console.anthropic.com → API Keys
# Billed per call. Every agent run goes through this key, so treat it as a
# spending secret as much as a security one.
ANTHROPIC_API_KEY=


# ───────────────────────────────────────────────────────────────────────────
# CAREER SCOUT — job providers
#
# Both are OPTIONAL. An unconfigured provider is skipped rather than erroring,
# so the feed degrades to whatever sources exist. With neither set, the jobs
# surface shows an honest empty state — it never invents a listing.
#
# You already have these in V1's .streamlit/secrets.toml; copy them across.
# ───────────────────────────────────────────────────────────────────────────

# JSearch via RapidAPI. WHERE: rapidapi.com → JSearch → your X-RapidAPI-Key.
# NOTE: the endpoint is /search-v2. The old /search 404s even with a valid key.
JSEARCH_API_KEY=
JSEARCH_HOST=jsearch.p.rapidapi.com

# Adzuna. WHERE: developer.adzuna.com → your app id + key.
# Adzuna PREDICTS salaries; predicted ones are dropped, never displayed.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ⚠️  V1 AND V2 SHARE ONE JSEARCH KEY during the parallel period.
# This cap is deliberately far below the plan limit so V2 testing cannot
# exhaust the quota out from under live V1 users. Raise it only after cutover.
JSEARCH_DAILY_CAP=25

# Shared cache: every user searching the same role × city shares one API call.
JOBS_CACHE_TTL_HOURS=48


# ───────────────────────────────────────────────────────────────────────────
# ADMIN GATE
# ───────────────────────────────────────────────────────────────────────────

# Comma-separated email allow-list. Matching is case-insensitive.
# EMPTY MEANS NOBODY IS ADMIN — a deliberate safe default. A misconfigured
# deploy locks admins out rather than letting everyone in.
# e.g. ADMIN_EMAILS=ravisravi31@gmail.com,support@carigma.in
ADMIN_EMAILS=


# ───────────────────────────────────────────────────────────────────────────
# CORS
# ───────────────────────────────────────────────────────────────────────────

# Comma-separated origins allowed to call this API from a browser.
# Local dev: the Vite server. Production: your Vercel domain.
# e.g. CORS_ORIGINS=https://carigma.in,https://www.carigma.in
CORS_ORIGINS=http://localhost:5173


# ───────────────────────────────────────────────────────────────────────────
# RATE LIMITS
#
# The credit gate stops COST; rate limits stop ABUSE. Different jobs.
# (Contract §1 / §21 Q7. Specified and configurable here; the limiter
# middleware itself is not implemented yet — see PROJECT_STATUS_V2.md §7.)
# ───────────────────────────────────────────────────────────────────────────

# 1. Authenticated agent runs, per user per agent.
AGENT_RUN_LIMIT_PER_HOUR=20

# 2. Unauthenticated public endpoints (the score-checker front door), per IP.
PUBLIC_LIMIT_PER_MINUTE=5

# 3. The JSearch quota is a SHARED resource, not per-user. It is handled by the
#    jobs cache + daily cap, NOT by a limiter here. Nothing to set.


# ═══════════════════════════════════════════════════════════════════════════
# NOT READ YET — coming in later phases
#
# Listed so you know where they will go and can gather them, but the API does
# NOT read these today. Setting them now has no effect (pydantic-settings is
# configured with extra="ignore", so unknown keys are harmless).
#
# Each will be added to `Settings` in the phase noted, at which point a test
# will require it to appear in this file.
# ═══════════════════════════════════════════════════════════════════════════

# (moved up — these are read as of P4; see the Career Scout block above)

# ── P5: Payments — BUILT, DORMANT ──
# The entire payment path exists and is tested. It stays OFF until Razorpay
# KYC clears. Flipping this to true with LIVE keys is the only change needed —
# no code edit, which is the whole reason it was built ahead of time.
#
# PAYMENTS_ENABLED must be true AND both keys present before any payment route
# is reachable; a flag on with no keys would render a checkout that cannot work.
PAYMENTS_ENABLED=false

# WHERE: Razorpay dashboard → Settings → API Keys.
# Test keys start `rzp_test_` and work end-to-end with Razorpay's fake payment
# methods. Admin surfaces which mode is active so nobody has to guess.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Where Razorpay sends the user back to after checkout. This is the WEB
# origin, not the API's — the callback lands on a page, not an endpoint.
APP_URL=http://localhost:5173

# ── P5: Emails — the retention loop ──
# WHERE: Hostinger → Emails → SMTP details.
# Leave blank and the cron FORCES --dry-run: it prints what it would send and
# sends nothing. A cron that silently does nothing is worse than one that says
# it would have.
#
# PORT DECIDES THE TLS HANDSHAKE, so get it right:
#   465 = implicit TLS (SMTPS)   -> the client opens an SSL socket immediately
#   587 = submission + STARTTLS  -> plaintext connect, then upgrade
# Hostinger gives 465. Setting 465 while the code does STARTTLS fails as a
# TIMEOUT rather than a clear error, so the port drives the choice in code.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Carigma <support@carigma.in>

# ── Who this deploy may email ─────────────────────────────────────────────
# V1 and V2 share one Supabase and the cron reads EVERY profile, so a real run
# emails live V1 users a V2 email. Nothing in `profiles` separates them.
#
# `allowlist` (the default) with an empty list emails NOBODY. That is
# deliberate: a deploy that configures nothing fails toward silence. Going wide
# is an explicit act.
#
#   EMAIL_AUDIENCE=allowlist   -> only EMAIL_ALLOWLIST addresses
#   EMAIL_AUDIENCE=everyone    -> every recipient the cron selects
EMAIL_AUDIENCE=allowlist
EMAIL_ALLOWLIST=

# ── Credits ───────────────────────────────────────────────────────────────
# `check_affordable` used to run FREE whenever the balance came back None, and
# None covered a FAILED READ as well as "no credits table on this machine". So
# a transient Supabase failure made every run free, on the money path, with
# nothing to show for it afterwards.
#
# Inferring a dev condition from a production failure was the actual bug. The
# bypass is now this switch. Leave it ON everywhere except a machine that has
# no credits table.
CREDITS_ENFORCED=true

# ── P5: Analytics ──
# PostHog project key. Fail-open — telemetry never breaks a user flow.
# WHERE: PostHog → Project Settings → Project API Key.
# POSTHOG_KEY=
